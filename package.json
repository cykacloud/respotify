{
  "name": "respotify",
  "version": "2.0.0",
  "type": "commonjs",
  "description": "headless spotify auth and track downloader",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:verify",
    "build:verify": "tsup && git diff --exit-code --stat -- dist"
  },
  "keywords": [
    "spotify",
    "librespot",
    "login5",
    "widevine",
    "downloader"
  ],
  "author": "neverlane",
  "license": "ISC",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^1.7.0",
    "@types/debug": "^4.1.12",
    "@types/node": "^22.7.6",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "eslint": "^8.57.0",
    "tsup": "^8.0.2",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "debug": "^4.3.7",
    "ffmpeg-static": "^5.2.0",
    "long": "^5.2.3",
    "protobufjs": "^7.2.6",
    "undici": "^6.20.1"
  }
}
